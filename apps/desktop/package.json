{
  "name": "nexa-desktop",
  "private": true,
  "version": "0.13.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:autoport": "node ./scripts/tauri-dev-autoport.mjs",
    "build": "npm run i18n:check && npm run typescript:check && tsc -b && vite build",
    "typecheck": "npm run typescript:check && tsc --noEmit",
    "typescript:check": "node ./scripts/typescript-runtime-contract.mjs",
    "test": "npm run i18n:check && npm run test:streaming && npm run test:voice-runtime && npm run test:media-source-scope && npm run test:office-artifact-evidence && npm run test:image-provider-catalog && npm run test:theme-resource-plugin",
    "i18n:generate": "node ./scripts/i18n-namespaces.mjs generate",
    "i18n:check": "node ./scripts/i18n-namespaces.mjs check",
    "test:streaming": "node ./scripts/run-streaming-contracts.mjs",
    "test:voice-runtime": "node ./scripts/run-voice-runtime-contracts.mjs",
    "test:media-source-scope": "node --test ./scripts/media-source-scope.test.mts",
    "test:office-artifact-evidence": "node --test ./scripts/office-artifact-evidence.test.mts",
    "test:image-provider-catalog": "node --test ./scripts/image-provider-capability-catalog.test.mts",
    "test:theme-resource-plugin": "node --test ./scripts/theme-resource-plugin.test.mts",
    "preview": "vite preview",
    "tauri": "node ./scripts/tauri-cli.mjs",
    "e2e": "playwright test",
    "e2e:context": "playwright test e2e/context-usage-persistence.spec.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.11",
    "emoji-mart": "5.6.0",
    "framer-motion": "^12.34.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.16.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^6.0.0"
  }
}
