{
  "$schema": "https://raw.githubusercontent.com/nicegui2/tauri-schema/refs/heads/main/schema.json",
  "productName": "Nexa",
  "version": "0.13.6",
  "identifier": "com.nexa.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nexa",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#0d0a18",
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.huggingface.co; frame-src https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/generated-audio/**/*",
          "$APPDATA/theme-assets/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/openxml-validator/": "openxml-validator/",
      "resources/office-addin/": "office-addin/",
      "resources/pptxgenjs-runtime/": "pptxgenjs-runtime/"
    },
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNzgxNzY0RkEyQjQ4QzUKUldURlNDdjZaQmQ0WGtVenFxT3U4ZVc0YW8reDZTalBMTjhuZENNV3VYeUZidkljQU11YmV5MHAK",
      "endpoints": [
        "https://github.com/MLGBJDLW/Nexa/releases/latest/download/latest.json",
        "https://mirror.ghproxy.com/https://github.com/MLGBJDLW/Nexa/releases/latest/download/latest-ghproxy.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
