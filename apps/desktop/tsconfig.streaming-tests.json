{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "target/streaming-contracts"
  },
  "include": [
    "tests/**/*.test.ts",
    "src/lib/chatAttachments.ts",
    "src/lib/boundedConversationCache.ts",
    "src/lib/localStorageMigrations.ts",
    "src/lib/interactionStore.ts",
    "src/lib/slashCommands.ts",
    "src/lib/workflowRecorder.ts",
    "src/lib/streaming/**/*.ts",
    "src/lib/streaming/toolCardPresentation.ts",
    "src/types/**/*.ts"
  ]
}
