{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.local/schemas/office-validation-contract-v2.schema.json",
  "title": "Nexa Office Validation Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion"],
  "properties": {
    "contractVersion": {"const": 2},
    "required_text": {"type": "array", "items": {"type": "string"}},
    "forbidden_text": {"type": "array", "items": {"type": "string"}},
    "required_sheets": {"type": "array", "items": {"type": "string"}},
    "required_named_ranges": {"type": "array", "items": {"type": "string"}},
    "no_numeric_hardcodes_in": {"type": "array", "items": {"type": "string"}},
    "min_rows": {"type": "object"},
    "sentinels": {"type": "object"},
    "require_formula_cache": {"type": "boolean"},
    "tie_outs": {"type": "array", "items": {"type": "object"}},
    "reconciliations": {"type": "array", "items": {"type": "object"}},
    "formula_patterns": {"type": "array", "items": {"type": "object"}},
    "required_provenance": {"type": "object"},
    "min_paragraphs": {"type": "integer", "minimum": 0},
    "min_tables": {"type": "integer", "minimum": 0},
    "required_styles": {"type": "array", "items": {"type": "string"}},
    "no_heading_level_skips": {"type": "boolean"},
    "require_alt_text": {"type": "boolean"},
    "require_table_header_rows": {"type": "boolean"},
    "require_fixed_table_layout": {"type": "boolean"},
    "required_language": {"type": "string"},
    "min_comments": {"type": "integer", "minimum": 0},
    "require_tracked_changes": {"type": "boolean"},
    "require_no_tracked_changes": {"type": "boolean"},
    "min_slides": {"type": "integer", "minimum": 0},
    "max_slides": {"type": "integer", "minimum": 0},
    "required_slide_titles": {"type": "array", "items": {"type": "string"}},
    "require_speaker_notes": {"type": "boolean"}
  }
}
