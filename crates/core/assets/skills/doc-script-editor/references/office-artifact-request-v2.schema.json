{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.local/schemas/office-artifact-request-v2.schema.json",
  "title": "Nexa OfficeArtifact Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestVersion", "format", "intent", "operations"],
  "properties": {
    "requestVersion": {"type": "integer", "const": 2},
    "format": {"type": "string", "enum": ["docx", "xlsx", "pptx"]},
    "intent": {"type": "string", "enum": ["create", "modify", "verify"]},
    "source": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "operations": {"type": "array"},
    "guarantees": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "quality": {"type": "string", "enum": ["draft", "standard", "publish", "native"]},
        "preservation": {"type": "string", "enum": ["strict", "balanced", "replace"]},
        "calculation": {"type": "string", "enum": ["not_required", "static", "compatible", "native"]},
        "render": {"type": "string", "enum": ["none", "important_surfaces", "all"]}
      }
    },
    "preconditions": {"type": "object", "additionalProperties": false, "properties": {"sourceSha256": {"$ref": "#/$defs/sha256"}}},
    "validation": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "office-validation-contract-v2.schema.json"}]},
    "delivery": {"type": "object", "additionalProperties": false, "properties": {"mode": {"type": "string", "enum": ["candidate", "publish"]}, "manifest": {"type": "string", "minLength": 1}}}
  },
  "allOf": [
    {"if": {"properties": {"intent": {"enum": ["modify", "verify"]}}, "required": ["intent"]}, "then": {"required": ["source", "preconditions"], "properties": {"preconditions": {"required": ["sourceSha256"]}}}},
    {"if": {"properties": {"format": {"const": "docx"}}, "required": ["format"]}, "then": {"properties": {"operations": {"items": {"oneOf": [
      {"$ref": "#/$defs/docxCreate"}, {"$ref": "#/$defs/docxReplace"}, {"$ref": "#/$defs/docxRedact"},
      {"$ref": "#/$defs/docxSecureRedact"}, {"$ref": "#/$defs/docxAddComment"},
      {"$ref": "#/$defs/docxReplyComment"}, {"$ref": "#/$defs/docxResolveComment"},
      {"$ref": "#/$defs/docxTrackedReplace"}, {"$ref": "#/$defs/docxAddBookmark"},
      {"$ref": "#/$defs/docxInsertField"}, {"$ref": "#/$defs/docxContentControl"},
      {"$ref": "#/$defs/docxProtection"}, {"$ref": "#/$defs/docxTemplateBinding"}, {"$ref": "#/$defs/docxNoArg"}
    ]}}}}},
    {"if": {"properties": {"format": {"const": "xlsx"}}, "required": ["format"]}, "then": {"properties": {"operations": {"items": {"oneOf": [
      {"$ref": "#/$defs/xlsxCreate"}, {"$ref": "#/$defs/xlsxReplace"}, {"$ref": "#/$defs/xlsxSetValue"},
      {"$ref": "#/$defs/xlsxSetFormula"}, {"$ref": "#/$defs/xlsxSetRange"},
      {"$ref": "#/$defs/xlsxClearRange"}, {"$ref": "#/$defs/xlsxSetStyle"}, {"$ref": "#/$defs/xlsxNoArg"}
      , {"$ref": "#/$defs/xlsxRenameSheet"}, {"$ref": "#/$defs/xlsxDefinedName"},
      {"$ref": "#/$defs/xlsxDataValidation"}, {"$ref": "#/$defs/xlsxCreateTable"},
      {"$ref": "#/$defs/xlsxNumberFormat"}, {"$ref": "#/$defs/xlsxChartTitle"},
      {"$ref": "#/$defs/xlsxChartData"}
    ]}}}}},
    {"if": {"properties": {"format": {"const": "pptx"}}, "required": ["format"]}, "then": {"properties": {"operations": {"items": {"oneOf": [
      {"$ref": "#/$defs/pptxCreate"}, {"$ref": "#/$defs/pptxReplace"}, {"$ref": "#/$defs/pptxInsertSlide"},
      {"$ref": "#/$defs/pptxSetText"}, {"$ref": "#/$defs/pptxCloneSlide"},
      {"$ref": "#/$defs/pptxReorderSlides"}, {"$ref": "#/$defs/pptxSetTransition"}, {"$ref": "#/$defs/pptxNoArg"}
      , {"$ref": "#/$defs/pptxAltText"}, {"$ref": "#/$defs/pptxSpeakerNotes"},
      {"$ref": "#/$defs/pptxComment"}
    ]}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "slideId": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "shapeId": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "docxCreate": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "anyOf": [{"required": ["spec"]}, {"required": ["body"]}, {"required": ["inputMd"]}, {"required": ["prompt"]}],
      "properties": {"op": {"const": "create"}, "elementId": {"type": "string"}, "spec": {"type": "string"}, "title": {"type": "string"}, "subtitle": {"type": "string"}, "body": {"type": "string"}, "font": {"type": "string"}, "footer": {"type": "string"}, "author": {"type": "string"}, "inputMd": {"type": "string"}, "template": {"type": "string"}, "prompt": {"type": "string"}}
    },
    "docxReplace": {
      "type": "object", "additionalProperties": false, "required": ["op", "find"],
      "properties": {"op": {"const": "replace"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}, "expectedSha256": {"$ref": "#/$defs/sha256"}, "expectedMatches": {"type": "integer", "minimum": 0}, "scope": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}]}, "occurrence": {"type": "integer", "minimum": 1}, "allowStyleMerge": {"type": "boolean"}}
    },
    "docxRedact": {
      "type": "object", "additionalProperties": false, "required": ["op", "find"],
      "properties": {"op": {"const": "redact"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}, "expectedSha256": {"$ref": "#/$defs/sha256"}, "expectedMatches": {"type": "integer", "minimum": 0}, "scope": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}]}, "occurrence": {"type": "integer", "minimum": 1}, "allowStyleMerge": {"type": "boolean"}}
    },
    "docxSecureRedact": {
      "type": "object", "additionalProperties": false, "required": ["op", "find"],
      "properties": {"op": {"const": "secure_redact"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}, "expectedSha256": {"$ref": "#/$defs/sha256"}, "expectedMatches": {"type": "integer", "minimum": 0}, "privacyScrub": {"type": "boolean"}}
    },
    "docxAddComment": {
      "type": "object", "additionalProperties": false, "required": ["op", "find", "comment"],
      "properties": {"op": {"const": "add_comment"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "comment": {"type": "string"}, "author": {"type": "string"}, "initials": {"type": "string"}, "date": {"type": "string"}, "occurrence": {"type": "integer", "minimum": 1}}
    },
    "docxReplyComment": {
      "type": "object", "additionalProperties": false, "required": ["op", "commentId", "comment"],
      "properties": {"op": {"const": "reply_comment"}, "elementId": {"type": "string"}, "commentId": {"type": "string", "minLength": 1}, "comment": {"type": "string"}, "author": {"type": "string"}, "initials": {"type": "string"}, "date": {"type": "string"}}
    },
    "docxResolveComment": {
      "type": "object", "additionalProperties": false, "required": ["op", "commentId"],
      "properties": {"op": {"const": "resolve_comment"}, "elementId": {"type": "string"}, "commentId": {"type": "string", "minLength": 1}, "resolved": {"type": "boolean"}}
    },
    "docxTrackedReplace": {
      "type": "object", "additionalProperties": false, "required": ["op", "find", "replace"],
      "properties": {"op": {"const": "tracked_replace"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}, "author": {"type": "string"}, "date": {"type": "string"}, "occurrence": {"type": "integer", "minimum": 1}}
    },
    "docxAddBookmark": {"type": "object", "additionalProperties": false, "required": ["op", "find", "bookmarkName"], "properties": {"op": {"const": "add_bookmark"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "bookmarkName": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$"}, "occurrence": {"type": "integer", "minimum": 1}}},
    "docxInsertField": {"type": "object", "additionalProperties": false, "required": ["op", "find", "instruction"], "properties": {"op": {"const": "insert_field"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "instruction": {"type": "string", "pattern": "^(?:PAGE|NUMPAGES|SECTIONPAGES|TOC(?:\\s+\\\\[A-Za-z]+(?:\\s+[^\\\\]+)?)|REF\\s+[A-Za-z_][A-Za-z0-9_]{0,39}(?:\\s+\\\\[A-Za-z]+)*|SEQ\\s+[A-Za-z_][A-Za-z0-9_]{0,39}(?:\\s+\\\\[A-Za-z]+(?:\\s+\\S+)?)*)$", "description": "Safe Word field allowlist: PAGE, NUMPAGES, SECTIONPAGES, TOC switches, REF bookmark switches, or SEQ identifier switches."}, "displayText": {"type": "string"}, "occurrence": {"type": "integer", "minimum": 1}}},
    "docxContentControl": {"type": "object", "additionalProperties": false, "required": ["op", "find", "tag"], "properties": {"op": {"const": "wrap_content_control"}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "lock": {"type": "string", "enum": ["none", "content", "control"]}, "occurrence": {"type": "integer", "minimum": 1}}},
    "docxProtection": {"type": "object", "additionalProperties": false, "required": ["op", "mode"], "properties": {"op": {"const": "set_protection"}, "elementId": {"type": "string"}, "mode": {"type": "string", "enum": ["none", "readOnly", "comments", "trackedChanges", "forms"]}}},
    "docxTemplateBinding": {"type": "object", "additionalProperties": false, "required": ["op", "bindings"], "properties": {"op": {"const": "bind_template"}, "elementId": {"type": "string"}, "bindings": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}, "target": {"type": "string", "enum": ["auto", "content_control", "bookmark"]}, "allowMultiple": {"type": "boolean"}}},
    "docxNoArg": {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"enum": ["strip_comments", "accept_changes", "reject_changes", "validate", "render"]}, "elementId": {"type": "string"}}},
    "xlsxCreate": {"type": "object", "additionalProperties": false, "required": ["op", "spec"], "properties": {"op": {"const": "create"}, "elementId": {"type": "string"}, "spec": {"type": "string", "minLength": 1}}},
    "xlsxReplace": {"type": "object", "additionalProperties": false, "required": ["op", "find"], "properties": {"op": {"enum": ["replace", "redact"]}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}, "expectedSha256": {"$ref": "#/$defs/sha256"}, "expectedMatches": {"type": "integer", "minimum": 0}}},
    "xlsxSetValue": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "cell", "value"], "properties": {"op": {"const": "set_value"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "cell": {"type": "string"}, "value": {}}},
    "xlsxSetFormula": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "cell", "formula"], "properties": {"op": {"const": "set_formula"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "cell": {"type": "string"}, "formula": {"type": "string", "minLength": 1}, "cachedValue": {}}},
    "xlsxSetRange": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "range", "values"], "properties": {"op": {"const": "set_range"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "range": {"type": "string"}, "values": {"type": "array", "items": {"type": "array"}}}},
    "xlsxClearRange": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "range"], "properties": {"op": {"const": "clear_range"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "range": {"type": "string"}}},
    "xlsxSetStyle": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "styleId"], "oneOf": [{"required": ["cell"]}, {"required": ["range"]}], "properties": {"op": {"const": "set_style"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "cell": {"type": "string"}, "range": {"type": "string"}, "styleId": {"type": "integer", "minimum": 0}}},
    "xlsxRenameSheet": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "newName"], "properties": {"op": {"const": "rename_sheet"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "newName": {"type": "string", "minLength": 1}}},
    "xlsxDefinedName": {"type": "object", "additionalProperties": false, "required": ["op", "name", "formula"], "properties": {"op": {"const": "set_defined_name"}, "elementId": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "formula": {"type": "string", "minLength": 1}, "scopeSheet": {"type": "string"}}},
    "xlsxDataValidation": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "range", "validationType"], "properties": {"op": {"const": "set_data_validation"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "range": {"type": "string"}, "validationType": {"type": "string", "enum": ["whole", "decimal", "list", "date", "time", "textLength", "custom"]}, "operator": {"type": "string"}, "formula1": {"type": "string"}, "formula2": {"type": "string"}, "allowBlank": {"type": "boolean"}, "showErrorMessage": {"type": "boolean"}, "errorTitle": {"type": "string"}, "error": {"type": "string"}}},
    "xlsxCreateTable": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "range", "name"], "properties": {"op": {"const": "create_table"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "range": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "columns": {"type": "array", "items": {"type": "string", "minLength": 1}}, "styleName": {"type": "string"}}},
    "xlsxNumberFormat": {"type": "object", "additionalProperties": false, "required": ["op", "sheet", "formatCode"], "oneOf": [{"required": ["cell"]}, {"required": ["range"]}], "properties": {"op": {"const": "set_number_format"}, "elementId": {"type": "string"}, "sheet": {"type": "string"}, "cell": {"type": "string"}, "range": {"type": "string"}, "formatCode": {"type": "string", "minLength": 1}, "baseStyleId": {"type": "integer", "minimum": 0}}},
    "xlsxChartTitle": {"type": "object", "additionalProperties": false, "required": ["op", "chartPart", "title"], "properties": {"op": {"const": "set_chart_title"}, "elementId": {"type": "string"}, "chartPart": {"type": "string", "pattern": "^xl/charts/chart[0-9]+\\.xml$"}, "title": {"type": "string"}}},
    "xlsxChartData": {"type": "object", "additionalProperties": false, "required": ["op", "chartPart", "seriesIndex", "categories", "values"], "properties": {"op": {"const": "set_chart_data"}, "elementId": {"type": "string"}, "chartPart": {"type": "string", "pattern": "^xl/charts/chart[0-9]+\\.xml$"}, "seriesIndex": {"type": "integer", "minimum": 1}, "seriesName": {"type": "string"}, "categoryRange": {"type": "string", "minLength": 1}, "valueRange": {"type": "string", "minLength": 1}, "categories": {"type": "array", "minItems": 1, "items": {"type": ["string", "number", "boolean", "null"]}}, "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}}},
    "xlsxNoArg": {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"enum": ["recalculate", "validate", "render"]}, "elementId": {"type": "string"}}},
    "pptxCreate": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "anyOf": [{"required": ["spec"]}, {"required": ["prompt"]}, {"required": ["title"]}],
      "properties": {"op": {"const": "create"}, "elementId": {"type": "string"}, "spec": {"type": "string"}, "template": {"type": "string"}, "htmlFirst": {"type": "boolean"}, "outdir": {"type": "string"}, "mode": {"type": "string"}, "screenshot": {"type": "string"}, "title": {"type": "string"}, "prompt": {"type": "string"}, "authorEngine": {"type": "string", "enum": ["python", "pptxgenjs"]}}
    },
    "pptxReplace": {"type": "object", "additionalProperties": false, "required": ["op", "find"], "properties": {"op": {"enum": ["replace", "redact"]}, "elementId": {"type": "string"}, "find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}, "expectedSha256": {"$ref": "#/$defs/sha256"}, "expectedMatches": {"type": "integer", "minimum": 0}}},
    "pptxInsertSlide": {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"const": "insert_slide"}, "elementId": {"type": "string"}, "after": {"type": "integer", "minimum": 0}, "title": {"type": "string"}, "body": {"type": "string"}}},
    "pptxSetText": {"type": "object", "additionalProperties": false, "required": ["op", "text"], "allOf": [{"oneOf": [{"required": ["slideId"]}, {"required": ["slideIndex"]}]}, {"oneOf": [{"required": ["shapeId"]}, {"required": ["shapeName"]}]}], "properties": {"op": {"const": "set_text"}, "elementId": {"type": "string"}, "slideId": {"$ref": "#/$defs/slideId"}, "slideIndex": {"type": "integer", "minimum": 1}, "shapeId": {"$ref": "#/$defs/shapeId"}, "shapeName": {"type": "string"}, "text": {"type": "string"}}},
    "pptxCloneSlide": {"type": "object", "additionalProperties": false, "required": ["op"], "oneOf": [{"required": ["slideId"]}, {"required": ["slideIndex"]}], "properties": {"op": {"const": "clone_slide"}, "elementId": {"type": "string"}, "slideId": {"$ref": "#/$defs/slideId"}, "slideIndex": {"type": "integer", "minimum": 1}, "afterIndex": {"type": "integer", "minimum": 0}}},
    "pptxReorderSlides": {"type": "object", "additionalProperties": false, "required": ["op", "order"], "properties": {"op": {"const": "reorder_slides"}, "elementId": {"type": "string"}, "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slideId"}}}},
    "pptxSetTransition": {"type": "object", "additionalProperties": false, "required": ["op", "transition"], "oneOf": [{"required": ["slideId"]}, {"required": ["slideIndex"]}], "properties": {"op": {"const": "set_transition"}, "elementId": {"type": "string"}, "slideId": {"$ref": "#/$defs/slideId"}, "slideIndex": {"type": "integer", "minimum": 1}, "transition": {"type": "string"}, "speed": {"type": "string"}, "direction": {"type": "string"}}},
    "pptxAltText": {"type": "object", "additionalProperties": false, "required": ["op", "altText"], "allOf": [{"oneOf": [{"required": ["slideId"]}, {"required": ["slideIndex"]}]}, {"oneOf": [{"required": ["shapeId"]}, {"required": ["shapeName"]}]}], "properties": {"op": {"const": "set_alt_text"}, "elementId": {"type": "string"}, "slideId": {"$ref": "#/$defs/slideId"}, "slideIndex": {"type": "integer", "minimum": 1}, "shapeId": {"$ref": "#/$defs/shapeId"}, "shapeName": {"type": "string"}, "altText": {"type": "string"}, "title": {"type": "string"}}},
    "pptxSpeakerNotes": {"type": "object", "additionalProperties": false, "required": ["op", "text"], "oneOf": [{"required": ["slideId"]}, {"required": ["slideIndex"]}], "properties": {"op": {"const": "set_speaker_notes"}, "elementId": {"type": "string"}, "slideId": {"$ref": "#/$defs/slideId"}, "slideIndex": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}},
    "pptxComment": {"type": "object", "additionalProperties": false, "required": ["op", "comment"], "oneOf": [{"required": ["slideId"]}, {"required": ["slideIndex"]}], "properties": {"op": {"const": "add_comment"}, "elementId": {"type": "string"}, "slideId": {"$ref": "#/$defs/slideId"}, "slideIndex": {"type": "integer", "minimum": 1}, "comment": {"type": "string"}, "author": {"type": "string"}, "initials": {"type": "string"}, "date": {"type": "string"}, "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}}},
    "pptxNoArg": {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"enum": ["validate", "render"]}, "elementId": {"type": "string"}}}
  }
}
