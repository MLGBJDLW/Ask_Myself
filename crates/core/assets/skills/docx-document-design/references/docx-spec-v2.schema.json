{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.local/schemas/docx-spec-v2.schema.json",
  "title": "Nexa DOCX Spec v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blocks"],
  "properties": {
    "schemaVersion": {"const": 2},
    "preset": {"enum": ["executive", "technical", "proposal", "memo"]},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "author": {"type": "string"},
    "language": {"type": "string"},
    "template": {"type": "string"},
    "clearTemplateBody": {"type": "boolean"},
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {"enum": ["portrait", "landscape"]},
        "marginTop": {"type": "number", "minimum": 0},
        "marginBottom": {"type": "number", "minimum": 0},
        "marginLeft": {"type": "number", "minimum": 0},
        "marginRight": {"type": "number", "minimum": 0}
      }
    },
    "tokens": {"type": "object"},
    "header": {"type": "object"},
    "footer": {"type": "object"},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"enum": ["heading", "paragraph", "bullets", "numbered", "table", "image", "callout", "pageBreak", "sectionBreak"]},
          "text": {"type": "string"},
          "level": {"type": "integer", "minimum": 1, "maximum": 6},
          "items": {"type": "array"},
          "headers": {"type": "array"},
          "rows": {"type": "array"},
          "columnWidths": {"type": "array"},
          "repeatHeader": {"type": "boolean"},
          "allowRowBreaks": {"type": "boolean"},
          "path": {"type": "string"},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "altText": {"type": "string"},
          "caption": {"type": "string"},
          "kind": {"enum": ["info", "success", "warning", "risk"]},
          "orientation": {"enum": ["portrait", "landscape"]}
        }
      }
    }
  }
}
