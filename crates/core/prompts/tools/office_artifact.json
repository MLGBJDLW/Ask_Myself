{
  "name": "office_artifact",
  "description": "Inspect, assess, create, edit, verify, publish, discard, or restore DOCX, XLSX, and PPTX artifacts through Nexa's transactional OfficeArtifactEngine. Inspect returns stable sheet, slide, and shape identifiers needed by typed edits. Prefer this over manually composing run_shell document pipelines. execute creates a validated candidate by default; decide publishes or discards that candidate; restore uses a receipt and refuses to overwrite newer work.",
  "parameters": {
    "type": "object",
    "required": ["action", "workspace_root"],
    "properties": {
      "action": {
        "type": "string",
        "enum": ["capabilities", "inspect", "assess", "execute", "decide", "restore", "live_status", "live_pairing", "live_execute"],
        "description": "Lifecycle action. Use assess before guarantees that require optional native/render backends."
      },
      "workspace_root": {
        "type": "string",
        "description": "Registered local source directory that contains every source, destination, spec, manifest, candidate, and receipt path."
      },
      "source": {
        "type": "string",
        "description": "Existing Office artifact inside workspace_root; required for inspect."
      },
      "format": {
        "type": "string",
        "enum": ["docx", "xlsx", "pptx"],
        "description": "Optional format assertion for inspect; otherwise inferred from the Office extension."
      },
      "request": {
        "type": "object",
        "description": "OfficeArtifact requestVersion 2 payload for assess or execute.",
        "properties": {
          "requestVersion": {"type": "integer", "enum": [2]},
          "format": {"type": "string", "enum": ["docx", "xlsx", "pptx"]},
          "intent": {"type": "string", "enum": ["create", "modify", "verify"]},
          "source": {"type": "string"},
          "destination": {"type": "string"},
          "operations": {"type": "array", "items": {"type": "object"}},
          "guarantees": {
            "type": "object",
            "properties": {
              "quality": {"type": "string", "enum": ["draft", "standard", "publish", "native"]},
              "preservation": {"type": "string", "enum": ["strict", "balanced", "replace"]},
              "calculation": {"type": "string", "enum": ["not_required", "static", "compatible", "native"]},
              "render": {"type": "string", "enum": ["none", "important_surfaces", "all"]}
            }
          },
          "preconditions": {
            "type": "object",
            "properties": {
              "sourceSha256": {
                "type": "string",
                "description": "Fail if the source no longer matches the inspected SHA-256."
              }
            }
          },
          "validation": {},
          "delivery": {
            "type": "object",
            "properties": {
              "mode": {"type": "string", "enum": ["candidate", "publish"]},
              "manifest": {"type": "string"}
            }
          }
        },
        "required": ["requestVersion", "format", "intent", "operations"]
      },
      "candidate_id": {
        "type": "string",
        "description": "Candidate id returned by execute; required for decide."
      },
      "decision": {
        "type": "string",
        "enum": ["publish", "discard"],
        "description": "Candidate decision; required for decide."
      },
      "receipt_id": {
        "type": "string",
        "description": "Publication receipt id; required for restore."
      },
      "live_session_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$",
        "description": "Connected Office.js host session id returned by live_status; required for live_execute."
      },
      "live_operation": {
        "description": "Capability-checked operation for the currently open Word, Excel, or PowerPoint document.",
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["op", "search", "replacement"], "properties": {"op": {"const": "word_replace_text"}, "search": {"type": "string"}, "replacement": {"type": "string"}, "matchCase": {"type": "boolean"}, "matchWholeWord": {"type": "boolean"}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "location", "text"], "properties": {"op": {"const": "word_insert_text"}, "location": {"enum": ["selection", "start", "end"]}, "text": {"type": "string"}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "search", "comment"], "properties": {"op": {"const": "word_add_comment"}, "search": {"type": "string"}, "comment": {"type": "string"}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "address", "values"], "properties": {"op": {"const": "excel_set_range"}, "sheet": {"type": "string"}, "address": {"type": "string"}, "values": {"type": "array", "items": {"type": "array"}}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "address", "formulas"], "properties": {"op": {"const": "excel_set_formula"}, "sheet": {"type": "string"}, "address": {"type": "string"}, "formulas": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "address", "format"], "properties": {"op": {"const": "excel_format_range"}, "sheet": {"type": "string"}, "address": {"type": "string"}, "format": {"type": "object"}}},
          {"type": "object", "additionalProperties": false, "required": ["op", "text"], "allOf": [{"oneOf": [{"required": ["slideId"]}, {"required": ["slideIndex"]}]}, {"oneOf": [{"required": ["shapeId"]}, {"required": ["shapeName"]}]}], "properties": {"op": {"const": "powerpoint_set_text"}, "slideId": {"type": "string"}, "slideIndex": {"type": "integer", "minimum": 1}, "shapeId": {"type": "string"}, "shapeName": {"type": "string"}, "text": {"type": "string"}}},
          {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"const": "powerpoint_add_slide"}, "layoutId": {"type": "string"}, "title": {"type": "string"}}}
        ]
      }
    }
  }
}
